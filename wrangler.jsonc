{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecommerce-enabler",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecommerce-enabler",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_MEDIA",
      "bucket_name": "ecommerce-enabler-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "ecommerce-enabler-notifications"
      }
    ],
    "consumers": [
      {
        "queue": "ecommerce-enabler-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "ecommerce-enabler-notifications-dlq"
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ADMIN_EMAILS": "",
    "DEV_ADMIN_EMAIL": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "PUBLIC_BASE_URL": "https://temanmakan.biz.id",
    "TURNSTILE_SITE_KEY": "",
    "STORE_ORIGIN_DESTINATION_ID": "",
    "MINIMUM_PACKAGE_WEIGHT_GRAMS": "1000",
    "SHIPPING_QUOTE_TTL_SECONDS": "900",
    "KOMERCE_PAYMENT_TYPE": "qris",
    "KOMERCE_CHANNEL_CODE": "",
    "EMAIL_FROM": "Teman Makan <orders@example.com>",
    "VAPID_SUBJECT": "mailto:owner@example.com"
  },
  "secrets": {
    "required": [
      "RAJAONGKIR_API_KEY",
      "KOMERCE_PAYMENT_API_KEY",
      "KOMERCE_CALLBACK_SECRET",
      "ORDER_TOKEN_SECRET",
      "RESEND_API_KEY",
      "TURNSTILE_SECRET_KEY",
      "VAPID_PUBLIC_KEY",
      "VAPID_PRIVATE_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
